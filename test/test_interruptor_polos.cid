<?xml version="1.0" encoding="UTF-8"?>
<!--
  Interruptor con disparo monopolar: un XCBR por polo y otro para el interruptor completo,
  comandados por un solo CSWI, como modela un relé de línea. Sintético, generado para este
  repo a partir de test_bay_control.cid: no lleva nombres, direcciones ni señales de ninguna
  instalación.

  Q0CSWI1 se empareja por prefijo e instancia con Q0XCBR1 (polo A). Q0XCBR2 y Q0XCBR3
  (polos B y C) y Q0XCBR4 (trifásico) no tienen CSWI propio: tienen que moverse con él.
  Q0XSWI1 es un seccionador sin CSWI y tiene que quedar quieto.
  Ver test/TestInterruptorPolos.java.
-->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" version="2007" revision="B">
  <Header id="TestBayControl" version="1" revision="1" toolID="IEDNavigator"/>
  <Communication>
    <SubNetwork name="SN1" type="8-MMS">
      <ConnectedAP iedName="BAYCTRL" apName="AP1">
        <Address>
          <P type="IP">127.0.0.1</P>
          <P type="IP-SUBNET">255.255.255.0</P>
          <P type="IP-GATEWAY">127.0.0.1</P>
          <P type="OSI-AP-Title">1,3,9999,33</P>
          <P type="OSI-AE-Qualifier">33</P>
          <P type="OSI-PSEL">00000001</P>
          <P type="OSI-SSEL">0001</P>
          <P type="OSI-TSEL">0001</P>
        </Address>
      </ConnectedAP>
    </SubNetwork>
  </Communication>
  <IED name="POLOS" type="TestInterruptorPolos" manufacturer="IEDNavigator" configVersion="1.0">
    <AccessPoint name="AP1">
      <Server>
        <Authentication/>
        <LDevice inst="CTRL">
          <LN0 lnClass="LLN0" inst="" lnType="LLN0_T">
            <DOI name="Mod">
              <DAI name="ctlModel"><Val>status-only</Val></DAI>
            </DOI>
          </LN0>
          <LN lnClass="LPHD" inst="1" lnType="LPHD_T"/>

          <!-- Nodo que se opera. Es el único con ctlModel operable. -->
          <LN prefix="Q0" lnClass="CSWI" inst="1" lnType="CSWI_T">
            <DOI name="Mod">
              <DAI name="ctlModel"><Val>status-only</Val></DAI>
            </DOI>
            <DOI name="Pos">
              <DAI name="ctlModel"><Val>sbo-with-enhanced-security</Val></DAI>
              <DAI name="sboTimeout"><Val>300000</Val></DAI>
            </DOI>
          </LN>

          <!-- Aparato: posición de sólo lectura y los bloqueos de maniobra. -->
          <LN prefix="Q0" lnClass="XCBR" inst="1" lnType="XCBR_T">
            <DOI name="Mod">
              <DAI name="ctlModel"><Val>status-only</Val></DAI>
            </DOI>
            <DOI name="Pos">
              <DAI name="ctlModel"><Val>status-only</Val></DAI>
            </DOI>
          </LN>

          <!-- Polos B y C y el interruptor trifasico. -->
          <LN prefix="Q0" lnClass="XCBR" inst="2" lnType="XCBR_T">
            <DOI name="Mod">
              <DAI name="ctlModel"><Val>status-only</Val></DAI>
            </DOI>
            <DOI name="Pos">
              <DAI name="ctlModel"><Val>status-only</Val></DAI>
            </DOI>
          </LN>
          <LN prefix="Q0" lnClass="XCBR" inst="3" lnType="XCBR_T">
            <DOI name="Mod">
              <DAI name="ctlModel"><Val>status-only</Val></DAI>
            </DOI>
            <DOI name="Pos">
              <DAI name="ctlModel"><Val>status-only</Val></DAI>
            </DOI>
          </LN>
          <LN prefix="Q0" lnClass="XCBR" inst="4" lnType="XCBR_T">
            <DOI name="Mod">
              <DAI name="ctlModel"><Val>status-only</Val></DAI>
            </DOI>
            <DOI name="Pos">
              <DAI name="ctlModel"><Val>status-only</Val></DAI>
            </DOI>
          </LN>
          <!-- Seccionador sin CSWI: no es parte del interruptor. -->
          <LN prefix="Q0" lnClass="XSWI" inst="1" lnType="XCBR_T">
            <DOI name="Pos">
              <DAI name="ctlModel"><Val>status-only</Val></DAI>
            </DOI>
          </LN>

          <!-- Enclavamiento del mismo Logical Device. -->
          <LN prefix="Q0" lnClass="CILO" inst="1" lnType="CILO_T">
            <DOI name="Mod">
              <DAI name="ctlModel"><Val>status-only</Val></DAI>
            </DOI>
          </LN>
        </LDevice>
      </Server>
    </AccessPoint>
  </IED>
  <DataTypeTemplates>
    <LNodeType id="LLN0_T" lnClass="LLN0">
      <DO name="Mod" type="ENC_T"/>
      <DO name="Beh" type="ENS_T"/>
      <DO name="Health" type="ENS_HEALTH_T"/>
      <DO name="NamPlt" type="LPL_T"/>
      <DO name="Loc" type="SPS_T"/>
    </LNodeType>
    <LNodeType id="LPHD_T" lnClass="LPHD">
      <DO name="PhyNam" type="DPL_T"/>
      <DO name="PhyHealth" type="ENS_HEALTH_T"/>
      <DO name="Proxy" type="SPS_T"/>
    </LNodeType>
    <LNodeType id="CSWI_T" lnClass="CSWI">
      <DO name="Mod" type="ENC_T"/>
      <DO name="Beh" type="ENS_T"/>
      <DO name="Health" type="ENS_HEALTH_T"/>
      <DO name="NamPlt" type="LPL_T"/>
      <DO name="Loc" type="SPS_T"/>
      <DO name="Pos" type="DPC_CTL_T"/>
    </LNodeType>
    <LNodeType id="XCBR_T" lnClass="XCBR">
      <DO name="Mod" type="ENC_T"/>
      <DO name="Beh" type="ENS_T"/>
      <DO name="Health" type="ENS_HEALTH_T"/>
      <DO name="NamPlt" type="LPL_T"/>
      <DO name="Loc" type="SPS_T"/>
      <DO name="OpCnt" type="INS_T"/>
      <DO name="Pos" type="DPC_STAT_T"/>
      <DO name="BlkOpn" type="SPS_T"/>
      <DO name="BlkCls" type="SPS_T"/>
    </LNodeType>
    <LNodeType id="CILO_T" lnClass="CILO">
      <DO name="Mod" type="ENC_T"/>
      <DO name="Beh" type="ENS_T"/>
      <DO name="Health" type="ENS_HEALTH_T"/>
      <DO name="NamPlt" type="LPL_T"/>
      <DO name="EnaOpn" type="SPS_T"/>
      <DO name="EnaCls" type="SPS_T"/>
    </LNodeType>

    <DOType id="ENC_T" cdc="ENC">
      <DA name="stVal" fc="ST" dchg="true" bType="Enum" type="BehKind"/>
      <DA name="q" fc="ST" qchg="true" bType="Quality"/>
      <DA name="t" fc="ST" bType="Timestamp"/>
      <DA name="ctlModel" fc="CF" bType="Enum" type="CtlModelKind"/>
    </DOType>
    <DOType id="ENS_T" cdc="ENS">
      <DA name="stVal" fc="ST" dchg="true" bType="Enum" type="BehKind"/>
      <DA name="q" fc="ST" qchg="true" bType="Quality"/>
      <DA name="t" fc="ST" bType="Timestamp"/>
    </DOType>
    <DOType id="ENS_HEALTH_T" cdc="ENS">
      <DA name="stVal" fc="ST" dchg="true" bType="Enum" type="HealthKind"/>
      <DA name="q" fc="ST" qchg="true" bType="Quality"/>
      <DA name="t" fc="ST" bType="Timestamp"/>
    </DOType>
    <DOType id="SPS_T" cdc="SPS">
      <DA name="stVal" fc="ST" dchg="true" bType="BOOLEAN"/>
      <DA name="q" fc="ST" qchg="true" bType="Quality"/>
      <DA name="t" fc="ST" bType="Timestamp"/>
    </DOType>
    <DOType id="INS_T" cdc="INS">
      <DA name="stVal" fc="ST" dchg="true" bType="INT32"/>
      <DA name="q" fc="ST" qchg="true" bType="Quality"/>
      <DA name="t" fc="ST" bType="Timestamp"/>
    </DOType>
    <DOType id="LPL_T" cdc="LPL">
      <DA name="vendor" fc="DC" bType="VisString255"/>
      <DA name="swRev" fc="DC" bType="VisString255"/>
      <DA name="d" fc="DC" bType="VisString255"/>
      <DA name="configRev" fc="DC" bType="VisString255"/>
    </DOType>
    <DOType id="DPL_T" cdc="DPL">
      <DA name="vendor" fc="DC" bType="VisString255"/>
      <DA name="model" fc="DC" bType="VisString255"/>
      <DA name="serNum" fc="DC" bType="VisString255"/>
    </DOType>

    <!-- Posición comandable: SBO en dos pasos, con Check en SBOw y en Oper. -->
    <DOType id="DPC_CTL_T" cdc="DPC">
      <DA name="origin" fc="ST" bType="Struct" type="Originator_T"/>
      <DA name="ctlNum" fc="ST" bType="INT8U"/>
      <DA name="stVal" fc="ST" dchg="true" bType="Dbpos"/>
      <DA name="q" fc="ST" qchg="true" bType="Quality"/>
      <DA name="t" fc="ST" bType="Timestamp"/>
      <DA name="stSeld" fc="ST" dchg="true" bType="BOOLEAN"/>
      <DA name="ctlModel" fc="CF" bType="Enum" type="CtlModelKind"/>
      <DA name="sboTimeout" fc="CF" bType="INT32U"/>
      <DA name="SBOw" fc="CO" bType="Struct" type="DPCOperate_T"/>
      <DA name="Oper" fc="CO" bType="Struct" type="DPCOperate_T"/>
      <DA name="Cancel" fc="CO" bType="Struct" type="DPCCancel_T"/>
    </DOType>
    <!-- Posición del aparato: sólo lectura. -->
    <DOType id="DPC_STAT_T" cdc="DPC">
      <DA name="stVal" fc="ST" dchg="true" bType="Dbpos"/>
      <DA name="q" fc="ST" qchg="true" bType="Quality"/>
      <DA name="t" fc="ST" bType="Timestamp"/>
      <DA name="ctlModel" fc="CF" bType="Enum" type="CtlModelKind"/>
    </DOType>

    <DAType id="DPCOperate_T">
      <BDA name="ctlVal" bType="BOOLEAN"/>
      <BDA name="origin" bType="Struct" type="Originator_T"/>
      <BDA name="ctlNum" bType="INT8U"/>
      <BDA name="T" bType="Timestamp"/>
      <BDA name="Test" bType="BOOLEAN"/>
      <BDA name="Check" bType="Check"/>
    </DAType>
    <DAType id="DPCCancel_T">
      <BDA name="ctlVal" bType="BOOLEAN"/>
      <BDA name="origin" bType="Struct" type="Originator_T"/>
      <BDA name="ctlNum" bType="INT8U"/>
      <BDA name="T" bType="Timestamp"/>
      <BDA name="Test" bType="BOOLEAN"/>
    </DAType>
    <DAType id="Originator_T">
      <BDA name="orCat" bType="Enum" type="OrCatKind"/>
      <BDA name="orIdent" bType="Octet64"/>
    </DAType>

    <EnumType id="BehKind">
      <EnumVal ord="1">on</EnumVal>
      <EnumVal ord="2">blocked</EnumVal>
      <EnumVal ord="3">test</EnumVal>
      <EnumVal ord="4">test/blocked</EnumVal>
      <EnumVal ord="5">off</EnumVal>
    </EnumType>
    <EnumType id="HealthKind">
      <EnumVal ord="1">Ok</EnumVal>
      <EnumVal ord="2">Warning</EnumVal>
      <EnumVal ord="3">Alarm</EnumVal>
    </EnumType>
    <EnumType id="CtlModelKind">
      <EnumVal ord="0">status-only</EnumVal>
      <EnumVal ord="1">direct-with-normal-security</EnumVal>
      <EnumVal ord="2">sbo-with-normal-security</EnumVal>
      <EnumVal ord="3">direct-with-enhanced-security</EnumVal>
      <EnumVal ord="4">sbo-with-enhanced-security</EnumVal>
    </EnumType>
    <EnumType id="OrCatKind">
      <EnumVal ord="0">not-supported</EnumVal>
      <EnumVal ord="1">bay-control</EnumVal>
      <EnumVal ord="2">station-control</EnumVal>
      <EnumVal ord="3">remote-control</EnumVal>
      <EnumVal ord="4">automatic-bay</EnumVal>
      <EnumVal ord="5">automatic-station</EnumVal>
      <EnumVal ord="6">automatic-remote</EnumVal>
      <EnumVal ord="7">maintenance</EnumVal>
      <EnumVal ord="8">process</EnumVal>
    </EnumType>
  </DataTypeTemplates>
</SCL>
